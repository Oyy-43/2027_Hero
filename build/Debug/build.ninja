build CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D "D:\A New RM\2027_HeroProject\Hero_2027\build\Debug" && C:\msys64\mingw64\bin\cmake-gui.exe -S"D:\A New RM\2027_HeroProject\Hero_2027" -B"D:\A New RM\2027_HeroProject\Hero_2027\build\Debug""
  DESC = Running CMake cache editor...
  pool = console
  restat = 1

build edit_cache: phony CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D "D:\A New RM\2027_HeroProject\Hero_2027\build\Debug" && C:\msys64\mingw64\bin\cmake.exe --regenerate-during-build -S"D:\A New RM\2027_HeroProject\Hero_2027" -B"D:\A New RM\2027_HeroProject\Hero_2027\build\Debug""
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

