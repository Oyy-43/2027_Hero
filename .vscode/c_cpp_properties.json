{
    "configurations": [
        {
            "name": "Hero_2027 Debug",
            "compilerPath": "/usr/bin/arm-none-eabi-g++",
            "compileCommands": "${workspaceFolder}/build/Debug/compile_commands.json",
            "intelliSenseMode": "linux-gcc-arm",
            "cStandard": "c11",
            "cppStandard": "c++17",
            "includePath": [
                "${workspaceFolder}/User_Files/**",
                "${workspaceFolder}/Core/Inc",
                "${workspaceFolder}/Drivers/**",
                "${workspaceFolder}/Middlewares/**",
                "${workspaceFolder}/USB_DEVICE/**"
            ],
            "defines": [
                "STM32H723xx",
                "USE_HAL_DRIVER",
                "ARM_MATH_CM7"
            ]
        }
    ],
    "version": 4
}
